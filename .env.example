# Copy to .env and fill in as needed. Nothing here is required for retrieval
# evaluation, pytest, or CI. Never commit a real .env.

# --- Regression gate ---------------------------------------------------------
# Absolute Recall@10 drop that fails the gate. Must be a number > 0. Default 0.01.
REGRESSION_THRESHOLD=0.01
# Which config tests/test_regression_gate.py evaluates. Set to "broken" to see a real failure.
EVAL_CONFIG=baseline

# --- Retrieval models (sentence-transformers hub ids) ---------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM: Groq is the only supported provider ---------------------------------
# Free keys: https://console.groq.com . Only needed for the two optional features below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# RAG demo answers: "extractive" (default, no key) or "llm" (Groq writes the answer).
GENERATION_BACKEND=extractive
# Generation evaluation: false = free lexical heuristic (default); true = Groq LLM judge.
USE_LLM_JUDGE=false
