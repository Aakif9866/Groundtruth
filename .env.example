# Copy to .env and fill in as needed. Nothing here is required for the default
# retrieval-only evaluation path — these only matter for the optional
# Ragas-based generation evaluation.

# Regression gate threshold (absolute Recall@10 drop that fails CI). Default: 0.01
REGRESSION_THRESHOLD=0.01

# Which retrieval config the regression gate should treat as the "new" system.
# Default: baseline. Set to "broken" to reproduce a deliberate CI failure.
EVAL_CONFIG=baseline

# Embedding / reranker models (sentence-transformers hub ids).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation evaluation: off by default (uses a free, deterministic lexical
# heuristic). Set USE_RAGAS=true and provide an API key to use Ragas + an LLM
# judge for faithfulness / answer relevance instead.
USE_RAGAS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
